# ---------------------------------------------------------------------------
# Cookie Intelligence Agent — environment configuration
# ---------------------------------------------------------------------------
# Every value below is OPTIONAL. With no .env file at all the app runs against
# public Cookie Chain infrastructure and uses the deterministic (non-LLM)
# intelligence engine.

# --- Cookie Chain endpoints (public, no key required) ----------------------
NEXT_PUBLIC_COOKIE_RPC_URL=https://rpc.cookiescan.io
NEXT_PUBLIC_COOKIE_WSS_URL=wss://wss.cookiescan.io
NEXT_PUBLIC_COOKIE_DAS_URL=https://api.cookiescan.io
NEXT_PUBLIC_COOKIE_EXPLORER_URL=https://cookiescan.io

# --- AI narration (server-side only — NEVER prefix this with NEXT_PUBLIC_) --
# Without this key the AI panel falls back to the deterministic analyst, which
# answers every supported question from the same computed facts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
